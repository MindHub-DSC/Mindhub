# Copie para .env e troque a senha. O .env nunca é versionado.
# O backend lê este arquivo ao iniciar (src/config/ambiente.ts);
# variáveis já definidas no terminal têm prioridade.

# Porta HTTP da API (padrão: 3000)
PORT=3000

# PostgreSQL (o mesmo .env é lido pelo compose.yaml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=mindhub
DB_PASSWORD=troque-esta-senha
DB_NAME=mindhub

# Banco usado SÓ pelos testes de integração e E2E.
# O nome precisa terminar em _test: os testes se recusam a rodar em outro banco.
DB_TEST_NAME=mindhub_test
